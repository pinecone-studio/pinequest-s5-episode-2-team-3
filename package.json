{
  "name": "usny-smart-bottle",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && npx wrangler@4 deploy",
    "cap:sync": "bun run build && cap sync",
    "android": "bun run cap:sync && cap open android",
    "ios": "bun run cap:sync && cap open ios",
    "test:contract": "bun test shared/contracts.test.ts backend/migration.test.ts backend/contract.test.ts",
    "test:sync": "bun test shared/sync.test.ts backend/sync.test.ts tests/local-store.test.ts tests/sync.test.ts",
    "test:device": "bun test shared/device.test.ts backend/device-migration.test.ts backend/devices.test.ts backend/device-events.test.ts tests/devices.test.ts tests/scale.test.ts",
    "test:family": "bun test backend/family.test.ts"
  },
  "patchedDependencies": {
    "@capacitor-community/bluetooth-le@7.3.2": "patches/@capacitor-community%2Fbluetooth-le@7.3.2.patch",
    "@capacitor/local-notifications@7.0.7": "patches/@capacitor%2Flocal-notifications@7.0.7.patch"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.9",
    "fake-indexeddb": "^6.2.6",
    "typescript": "^5.9.3",
    "vite": "^6.4.1"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "7.3.2",
    "@capacitor/android": "7.6.9",
    "@capacitor/core": "7.6.9",
    "@capacitor/ios": "7.6.9",
    "@capacitor/local-notifications": "7.0.7",
    "@capgo/capacitor-health": "7.2.15",
    "@capgo/capacitor-social-login": "7.20.0"
  }
}
