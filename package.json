{
  "name": "usny-smart-bottle",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && npx wrangler@4 deploy",
    "cap:sync": "bun run build && cap sync",
    "android": "bun run cap:sync && cap open android",
    "ios": "bun run cap:sync && cap open ios",
    "test:contract": "bun test shared/contracts.test.ts backend/migration.test.ts backend/contract.test.ts",
    "test:sync": "bun test backend/sync.test.ts tests/sync.test.ts"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.9",
    "fake-indexeddb": "^6.2.6",
    "typescript": "^5.9.3",
    "vite": "^6.4.1"
  },
  "dependencies": {
    "@capacitor/android": "7.6.9",
    "@capacitor/core": "7.6.9",
    "@capacitor/ios": "7.6.9"
  }
}
