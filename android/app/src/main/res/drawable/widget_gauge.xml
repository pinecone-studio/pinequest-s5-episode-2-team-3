<?xml version="1.0" encoding="utf-8"?>
<!-- A 270° gauge open at the bottom, like a battery gauge. The ProgressBar's max is 1333, so a full
     1000 is 270°: secondaryProgress (fixed at 1000) is the track, progress the share done. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/secondaryProgress">
        <rotate android:fromDegrees="135" android:pivotX="50%" android:pivotY="50%" android:toDegrees="135">
            <shape android:innerRadius="22dp" android:shape="ring" android:thickness="6dp" android:useLevel="true">
                <solid android:color="@color/widget_track" />
            </shape>
        </rotate>
    </item>
    <item android:id="@android:id/progress">
        <rotate android:fromDegrees="135" android:pivotX="50%" android:pivotY="50%" android:toDegrees="135">
            <shape android:innerRadius="22dp" android:shape="ring" android:thickness="6dp" android:useLevel="true">
                <solid android:color="@color/widget_gauge_green" />
            </shape>
        </rotate>
    </item>
</layer-list>
