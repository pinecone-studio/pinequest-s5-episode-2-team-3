+    // Health Connect's own totals: de-duplicated across apps by the user's data source priority and
+    // prorated for records that cross the range edges, the same numbers Samsung Health shows.
+    @PluginMethod
+    fun aggregate(call: PluginCall) {
+        val startInstant: Instant
+        val endInstant: Instant
+        try {
+            endInstant = manager.parseInstant(call.getString("endDate"), Instant.now())
+            startInstant = manager.parseInstant(call.getString("startDate"), endInstant.minus(DEFAULT_PAST_DURATION))
+        } catch (e: DateTimeParseException) {
+            call.reject(e.message, null, e)
+            return
+        }
+        if (endInstant.isBefore(startInstant)) {
+            call.reject("endDate must be greater than or equal to startDate")
+            return
+        }
+
+        pluginScope.launch {
+            val client = getClientOrReject(call) ?: return@launch
+            try {
+                call.resolve(manager.aggregate(client, startInstant, endInstant))
+            } catch (e: Exception) {
+                call.reject(e.message ?: "Failed to aggregate.", null, e)
+            }
+        }
+    }
