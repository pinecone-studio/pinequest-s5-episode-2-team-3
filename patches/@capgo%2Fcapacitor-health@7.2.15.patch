+    // Steps, active kcal and heart rate in one request, each only when its read permission is granted
+    // (Health Connect rejects the whole request otherwise). A metric with no data is left out.
+    suspend fun aggregate(client: HealthConnectClient, startTime: Instant, endTime: Instant): JSObject {
+        val granted = client.permissionController.getGrantedPermissions()
+        val allowed = { type: HealthDataType -> granted.contains(type.readPermission) }
+        val metrics = buildSet<AggregateMetric<*>> {
+            if (allowed(HealthDataType.STEPS)) add(StepsRecord.COUNT_TOTAL)
+            if (allowed(HealthDataType.CALORIES)) add(ActiveCaloriesBurnedRecord.ACTIVE_CALORIES_TOTAL)
+            if (allowed(HealthDataType.HEART_RATE)) {
+                add(HeartRateRecord.BPM_AVG)
+                add(HeartRateRecord.BPM_MIN)
+                add(HeartRateRecord.BPM_MAX)
+            }
+        }
+        val result = JSObject()
+        if (metrics.isEmpty()) return result
+        val totals = client.aggregate(AggregateRequest(metrics, TimeRangeFilter.between(startTime, endTime)))
+        totals[StepsRecord.COUNT_TOTAL]?.let { result.put("steps", it) }
+        totals[ActiveCaloriesBurnedRecord.ACTIVE_CALORIES_TOTAL]?.let { result.put("activeKcal", it.inKilocalories) }
+        totals[HeartRateRecord.BPM_AVG]?.let { result.put("heartAvg", it) }
+        totals[HeartRateRecord.BPM_MIN]?.let { result.put("heartMin", it) }
+        totals[HeartRateRecord.BPM_MAX]?.let { result.put("heartMax", it) }
+        val origins = JSArray()
+        totals.dataOrigins.forEach { origins.put(it.packageName) }
+        result.put("sources", origins)
+        return result
+    }
