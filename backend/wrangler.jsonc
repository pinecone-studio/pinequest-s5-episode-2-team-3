// Backend API: Cloudflare Worker + D1 (replaces wrangler.toml, same settings).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dusal-api",
  "main": "src/index.js",
  "compatibility_date": "2025-06-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dusal",
      "database_id": "7010b809-a68a-4d46-a495-b379dd0086b0",
      "migrations_dir": "migrations"
    }
  ],
  // Doctor-note photos (create once: `npx wrangler r2 bucket create dusal-images`).
  "r2_buckets": [
    { "binding": "IMAGES", "bucket_name": "dusal-images" }
  ]
}
