// Backend API: Cloudflare Worker + D1 (replaces wrangler.toml, same settings).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dusal-api",
  "main": "src/index.js",
  "compatibility_date": "2025-06-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dusal",
      "database_id": "0243fe5d-00d4-4310-b3d7-035028581f7c",
      "migrations_dir": "migrations"
    }
  ]
}
